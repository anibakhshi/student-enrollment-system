APP_ENV=development
APP_PORT=8081

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

POSTGRES_DB=student_enrollment
POSTGRES_USER=student_app
POSTGRES_PASSWORD=student_secret
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgres://student_app:student_secret@localhost:5433/student_enrollment?sslmode=disable

UPLOAD_DIR=./uploads

# Django GUI
DJANGO_SECRET_KEY=change-this-secret-key-before-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,gui
DJANGO_SYNC_SEMATEC_ON_START=true
SEMATEC_SYNC_DELAY=0.2
GO_API_PUBLIC_URL=http://localhost:8081